''',
        "scripts/Car.gd": '''extends Node3D

var speed := 10.0
var turn_speed := 1.6

func _process(delta: float) -> void:
    var input_x := Input.get_axis("ui_left", "ui_right")
    var input_y := Input.get_axis("ui_up", "ui_down")

    if input_x != 0.0:
        rotation.y += input_x * turn_speed * delta
    if input_y != 0.0:
        position += -transform.basis.z * input_y * speed * delta
''',
        "scenes/Ball.tscn": '''[gd_scene load_steps=2 format=3 uid="uid://bo2i9k7yr81l1"]

[sub_resource type="SphereMesh" id="SphereMesh_4j168"]
radius = 0.5
height = 1.0

[node name="Ball" type="Node3D"]

[node name="BallMesh" type="MeshInstance3D" parent="."]
mesh = SubResource("SphereMesh_4j168")
''',
    }

    for relative_path, content in project_files.items():
        write_file(str(game_dir / relative_path), content, "director")

    return {"status": "created", "path": str(game_dir)}


if __name__ == "__main__":
    print(json.dumps(create_demo_project(), indent=2))
