[node name="DirectionalLight3D" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.866025, -0.5, 0, 0.5, 0.866025, 0, 0, 0, 1, 0, 12, 0)
shadow_enabled = true
''',
        "scripts/Main.gd": '''extends Node3D

var car_scene = preload("res://scenes/Car.tscn")
var football_scene = preload("res://scenes/Ball.tscn")
var cars = []

func _ready() -> void:
    create_field()
    spawn_cars()
    spawn_ball()

func create_field() -> void:
    var plane = MeshInstance3D.new()
    plane.mesh = PlaneMesh.new()
    plane.mesh.size = Vector2(40, 24)
    plane.material_override = StandardMaterial3D.new()
    plane.material_override.albedo_color = Color(0.13, 0.58, 0.18)
    add_child(plane)

    var wall_material = StandardMaterial3D.new()
    wall_material.albedo_color = Color(0.9, 0.9, 0.9)
    for i in range(4):
        var wall = StaticBody3D.new()
        var box = CollisionShape3D.new()
        box.shape = BoxShape3D.new()
        box.shape.extents = Vector3(20, 1, 0.5)
        wall.add_child(box)
        var mesh = MeshInstance3D.new()
        mesh.mesh = BoxMesh.new()
        mesh.mesh.size = Vector3(40, 2, 1)
        mesh.material_override = wall_material
        wall.add_child(mesh)
        add_child(wall)
        if i == 0:
            wall.position = Vector3(0, 1, -12)
        elif i == 1:
            wall.position = Vector3(0, 1, 12)
        elif i == 2:
            wall.position = Vector3(-20, 1, 0)
            wall.rotation_degrees.y = 90
        else:
            wall.position = Vector3(20, 1, 0)
            wall.rotation_degrees.y = 90

func spawn_cars() -> void:
    for i in range(2):
        var instance = car_scene.instantiate()
        instance.name = "Car%02d" % i
        instance.position = Vector3(-7 + i * 14, 1, 0)
        add_child(instance)
        cars.append(instance)

func spawn_ball() -> void:
    var ball = football_scene.instantiate()
    ball.position = Vector3(0, 1.5, 0)
    add_child(ball)
''',
        "scenes/Car.tscn": '''[gd_scene load_steps=3 format=3 uid="uid://ca24r8fbsu6v2"]

