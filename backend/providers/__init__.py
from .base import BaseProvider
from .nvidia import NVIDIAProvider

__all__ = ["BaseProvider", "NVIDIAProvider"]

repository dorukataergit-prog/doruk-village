def git_commit(message: str, agent: str = "system") -> str:
    start = time.time()
    logger = ToolLogger()
    try:
        subprocess.run(["git", "-C", str(ROOT), "add", "."], check=True, capture_output=True, text=True, timeout=60)
        commit = subprocess.run(["git", "-C", str(ROOT), "commit", "-m", message], capture_output=True, text=True, timeout=60)
        result = {"returncode": commit.returncode, "stdout": commit.stdout, "stderr": commit.stderr}
        logger.log(agent, "git_commit", {"message": message}, result, time.time() - start, commit.returncode == 0)
        return json.dumps(result)
    except Exception as exc:  # pragma: no cover
        logger.log(agent, "git_commit", {"message": message}, {"error": str(exc)}, time.time() - start, False)
        raise


def send_message(agent: str, message: str) -> Dict[str, str]:
    start = time.time()
    logger = ToolLogger()
    try:
        bus_path = LOGS_DIR / "messages.jsonl"
        payload = {"timestamp": datetime.now(timezone.utc).isoformat(), "agent": agent, "message": message}
        with bus_path.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(payload, ensure_ascii=False) + "\n")
        logger.log(agent, "send_message", {"agent": agent, "message": message}, payload, time.time() - start, True)
        return payload
    except Exception as exc:  # pragma: no cover
        logger.log(agent, "send_message", {"agent": agent, "message": message}, {"error": str(exc)}, time.time() - start, False)
        raise


def read_agent_memory(agent: str) -> str:
    start = time.time()
    logger = ToolLogger()
    try:
        memory_path = AGENTS_DIR / agent / "memory.md"
        if not memory_path.exists():
            return ""
        content = memory_path.read_text(encoding="utf-8")
        logger.log(agent, "read_agent_memory", {"agent": agent}, {"bytes": len(content)}, time.time() - start, True)
        return content
    except Exception as exc:  # pragma: no cover
        logger.log(agent, "read_agent_memory", {"agent": agent}, {"error": str(exc)}, time.time() - start, False)
        raise


def write_agent_memory(agent: str, content: str) -> str:
    start = time.time()
    logger = ToolLogger()
    try:
        path = AGENTS_DIR / agent
        path.mkdir(parents=True, exist_ok=True)
        memory_path = path / "memory.md"
        memory_path.write_text(content, encoding="utf-8")
        logger.log(agent, "write_agent_memory", {"agent": agent, "bytes": len(content)}, {"written": True}, time.time() - start, True)
        return str(memory_path)
    except Exception as exc:  # pragma: no cover
        logger.log(agent, "write_agent_memory", {"agent": agent}, {"error": str(exc)}, time.time() - start, False)
        raise


def get_env_value(name: str) -> Optional[str]:
    return SecretGuard.read_environment(name)


def list_agent_directories() -> List[str]:
    items = []
    for child in AGENTS_DIR.iterdir():
        if child.is_dir():
            items.append(child.name)
    return sorted(items)


def ensure_task_store() -> Path:
    TASKS_DIR.mkdir(parents=True, exist_ok=True)
    BENCHMARKS_DIR.mkdir(parents=True, exist_ok=True)
    tasks_path = TASKS_DIR / "tasks.json"
    if not tasks_path.exists():
        tasks_path.write_text("[]", encoding="utf-8")
    return tasks_path
