def run_command(command: str, agent: str = "system") -> str:
    start = time.time()
    logger = ToolLogger()
    try:
        CommandPolicy.validate(command)
        completed = subprocess.run(command, shell=True, capture_output=True, text=True, timeout=120, cwd=str(ROOT))
        result = {"returncode": completed.returncode, "stdout": completed.stdout, "stderr": completed.stderr}
        logger.log(agent, "run_command", {"command": command}, result, time.time() - start, completed.returncode == 0)
        return json.dumps(result)
    except Exception as exc:  # pragma: no cover
        logger.log(agent, "run_command", {"command": command}, {"error": str(exc)}, time.time() - start, False)
        raise


def run_godot(args: List[str], agent: str = "system") -> str:
    start = time.time()
    logger = ToolLogger()
    try:
        if not args:
            raise ValueError("No Godot args provided")
        proc = subprocess.run(["godot", *args], capture_output=True, text=True, timeout=180, cwd=str(ROOT))
        result = {"returncode": proc.returncode, "stdout": proc.stdout, "stderr": proc.stderr}
        logger.log(agent, "run_godot", {"args": args}, result, time.time() - start, proc.returncode == 0)
        return json.dumps(result)
    except FileNotFoundError:
        err = {"returncode": 127, "stdout": "", "stderr": "Godot binary not installed or not on PATH."}
        logger.log(agent, "run_godot", {"args": args}, err, time.time() - start, False)
        return json.dumps(err)
    except Exception as exc:  # pragma: no cover
        logger.log(agent, "run_godot", {"args": args}, {"error": str(exc)}, time.time() - start, False)
        raise


