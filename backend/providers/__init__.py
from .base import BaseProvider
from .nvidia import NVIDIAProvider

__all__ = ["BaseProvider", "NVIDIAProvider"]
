import json
import os
import subprocess
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, List, Optional

from backend.config import ROOT, LOGS_DIR, WORKSPACE_DIR, TASKS_DIR, BENCHMARKS_DIR, AGENTS_DIR
from backend.security import CommandPolicy, SafePathPolicy, SecretGuard


class ToolLogger:
    def __init__(self):
        LOGS_DIR.mkdir(parents=True, exist_ok=True)
        self.log_path = LOGS_DIR / "tool_calls.jsonl"

    def log(self, agent: str, tool: str, arguments: Dict[str, Any], result: Any, duration: float, success: bool):
        record = {
            "timestamp": datetime.now(timezone.utc).isoformat(),
            "agent": agent,
            "tool": tool,
            "arguments": arguments,
            "result": result,
            "duration": round(duration, 4),
            "success": success,
        }
        with self.log_path.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(record, ensure_ascii=False) + "\n")


def read_file(path: str, agent: str = "system") -> str:
    start = time.time()
    logger = ToolLogger()
    try:
        resolved = SafePathPolicy.validate(path)
        content = resolved.read_text(encoding="utf-8")
        logger.log(agent, "read_file", {"path": path}, {"bytes": len(content)}, time.time() - start, True)
        return content
    except Exception as exc:  # pragma: no cover
        logger.log(agent, "read_file", {"path": path}, {"error": str(exc)}, time.time() - start, False)
        raise


def write_file(path: str, content: str, agent: str = "system") -> str:
    start = time.time()
    logger = ToolLogger()
    try:
        resolved = SafePathPolicy.validate(path)
        resolved.parent.mkdir(parents=True, exist_ok=True)
        resolved.write_text(content, encoding="utf-8")
        logger.log(agent, "write_file", {"path": path, "bytes": len(content)}, {"written": True}, time.time() - start, True)
        return str(resolved)
    except Exception as exc:  # pragma: no cover
        logger.log(agent, "write_file", {"path": path}, {"error": str(exc)}, time.time() - start, False)
        raise


def edit_file(path: str, old_text: str, new_text: str, agent: str = "system") -> str:
    start = time.time()
    logger = ToolLogger()
    try:
        resolved = SafePathPolicy.validate(path)
        original = resolved.read_text(encoding="utf-8")
        if old_text not in original:
            raise ValueError(f"old_text not found in {path}")
        updated = original.replace(old_text, new_text, 1)
        resolved.write_text(updated, encoding="utf-8")
        logger.log(agent, "edit_file", {"path": path, "old_text": old_text[:80], "new_text": new_text[:80]}, {"updated": True}, time.time() - start, True)
        return str(resolved)
    except Exception as exc:  # pragma: no cover
        logger.log(agent, "edit_file", {"path": path}, {"error": str(exc)}, time.time() - start, False)
        raise


def list_files(path: str = ".", agent: str = "system") -> List[str]:
    start = time.time()
    logger = ToolLogger()
    try:
        base = SafePathPolicy.validate(path)
        items = sorted([str(p.relative_to(base.parent if str(base).endswith(".") else base)) for p in base.iterdir()]) if base.exists() else []
        logger.log(agent, "list_files", {"path": path}, {"items": items}, time.time() - start, True)
        return items
    except Exception as exc:  # pragma: no cover
        logger.log(agent, "list_files", {"path": path}, {"error": str(exc)}, time.time() - start, False)
        raise


